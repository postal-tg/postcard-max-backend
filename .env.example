APP_NAME=Postcard MAX Backend
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postcard:postcard@postgres:5432/postcard_bot
REDIS_URL=redis://redis:6379/0
MAX_API_BASE_URL=https://platform-api.max.ru
MAX_BOT_TOKEN=replace-me
MAX_BOT_SECRET=replace-me
MAX_BOT_NAME=@postcard_bot
MAX_BOT_PUBLIC_LINK=https://max.ru/postcard_bot
SERVER_URL=http://localhost:8000
WEBHOOK_PATH=/api/v1/max/webhook
BASE_WEBHOOK_URL=https://example.com
MAX_WEBHOOK_UPDATE_TYPES=message_created,message_callback,bot_started
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8000
INTERNAL_API_KEY=replace-me
PROMPT_TEXT_LIMIT=1000
MAX_MESSAGE_TEXT_LIMIT=4000
MAX_ACTIVE_GENERATIONS_PER_USER=1
RATE_LIMITER_CAPACITY=30
RATE_LIMITER_PERIOD=60
PROMPT_BLOCKLIST=nsfw,nude,porn,sex,explicit,gore,blood,violence
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
STORAGE_BUCKET=postcards
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_PUBLIC_BASE_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
GENERATION_RETRY_ATTEMPTS=4
GENERATION_RETRY_BACKOFF_SECONDS=3
POSTCARD_STYLE_PREAMBLE=Create a polished greeting postcard illustration suitable for messengers, focus on one clear visual idea, no text inside the image, warm composition, vibrant colors, clean details.
